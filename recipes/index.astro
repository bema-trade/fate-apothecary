---
import Base from '../../layouts/Base.astro';
import { getCollection } from 'astro:content';
const recipes = await getCollection('recipes');
---
<Base title="Recipes | Fate Apothecary" description="Flexible, practical recipes made for real life.">
  <section class="shell listing-page">
    <p class="eyebrow">Food that works in real life</p>
    <h1>Recipes</h1>
    <p class="listing-lede">The food I actually make — gluten-free, mostly dairy-free, flexible where it can be, precise where it needs to be.</p>
    <div class="recipe-grid">
      {recipes.map((recipe) => (
        <a class="recipe-card" href={`/recipes/${recipe.id}/`}>
          {recipe.data.image ? <img class="resource-card-image" src={recipe.data.image} alt="" /> : <div class="recipe-card-placeholder">{recipe.data.title}</div>}
          <h2>{recipe.data.title}</h2>
          <p>{recipe.data.description}</p>
          <div class="tag-row">{recipe.data.tags.map((tag) => <span>{tag}</span>)}</div>
        </a>
      ))}
    </div>
  </section>
</Base>
