---
import '../styles/global.css';

const { title = 'Fate Apothecary', description = 'Practical food, herbs, gardening, and everyday wellness.' } = Astro.props;
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width" />
    <meta name="description" content={description} />
    <title>{title}</title>
    <link rel="icon" href="/favicon.ico?v=13" sizes="any" />
    <link rel="icon" type="image/png" sizes="32x32" href="/favicon-32x32.png?v=13" />
    <link rel="icon" type="image/png" sizes="16x16" href="/favicon-16x16.png?v=13" />
    <link rel="apple-touch-icon" sizes="180x180" href="/apple-touch-icon.png?v=13" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Cormorant+Garamond:wght@500;600;700&family=Inter:wght@400;500;600&display=swap" rel="stylesheet" />
  </head>
  <body>
    <header class="site-header shell">
      <nav class="nav-side nav-left desktop-nav" aria-label="Site navigation">
        <a href="/">Home</a>
        <a href="/support">Support</a>
        <a href="/about">About</a>
      </nav>

      <button class="mobile-menu-button" id="mobile-menu-button" type="button" aria-expanded="false" aria-controls="mobile-menu" aria-label="Open menu">
        <span></span><span></span><span></span>
      </button>

      <a href="/" class="brand" aria-label="Fate Apothecary home">
        <img src="/images/fate-logo.png" alt="Fate Apothecary" />
      </a>

      <nav class="nav-side nav-right desktop-nav" aria-label="Content navigation">
        <a href="/recipes">Recipes</a>
        <a href="/herbs">Herbs</a>
        <a href="/garden">Garden</a>
        <a class="search-icon-link" href="/search" aria-label="Search Fate Apothecary" title="Search">
          <svg viewBox="0 0 24 24" aria-hidden="true"><circle cx="11" cy="11" r="6.5"></circle><path d="m16 16 4 4"></path></svg>
        </a>
      </nav>

      <a class="mobile-search-button" href="/search" aria-label="Search Fate Apothecary">
        <svg viewBox="0 0 24 24" aria-hidden="true"><circle cx="11" cy="11" r="6.5"></circle><path d="m16 16 4 4"></path></svg>
      </a>
    </header>

<nav class="mobile-menu" id="mobile-menu" aria-label="Mobile navigation" hidden>
  <div class="shell mobile-menu-inner">
    <a href="/">Home</a>
    <a href="/recipes">Recipes</a>
    <a href="/support">Support</a>
    <a href="/herbs">Herbs</a>
    <a href="/about">About</a>
    <a href="/garden">Garden</a>
  </div>
</nav>

    <main><slot /></main>
    <footer class="site-footer shell">
      <div class="footer-inner">
        <span>© 2023-2026 Fate Apothecary</span>
        <nav class="footer-links" aria-label="Footer navigation">
          <a href="/contact/">Contact</a>
          <span aria-hidden="true">•</span>
          <a href="/privacy/">Privacy</a>
        </nav>
      </div>
    </footer>

    <script>
      const menuButton = document.querySelector('#mobile-menu-button');
      const mobileMenu = document.querySelector('#mobile-menu');
      menuButton?.addEventListener('click', () => {
        const isOpen = menuButton.getAttribute('aria-expanded') === 'true';
        menuButton.setAttribute('aria-expanded', String(!isOpen));
        if (mobileMenu) mobileMenu.hidden = isOpen;
      });
    </script>
  </body>
</html>
