---
import Base from '../layouts/Base.astro';
import AboutTabs from '../components/AboutTabs.astro';
---
<Base title="Contact | Fate Apothecary" description="Contact Fate Apothecary.">
  <section class="about-page shell">
    <AboutTabs active="contact" />

    <p class="eyebrow">Contact Fate Apothecary</p>
    <h1>Say hello.</h1>

    <div class="about-copy">
      <p>
        Questions, corrections, collaboration ideas, or something you think we should know about? We’d love to hear from you.
      </p>
      <p>
        We’re getting the Fate Apothecary contact form connected now. This page is already in place so we can wire it up cleanly as soon as the email destination is ready.
      </p>
    </div>

    <aside class="about-note">
      <p class="eyebrow">A quick boundary</p>
      <p>
        Please don’t send personal medical questions. Fate Apothecary shares general educational information, but we can’t provide individualized medical advice, diagnosis, or treatment recommendations.
      </p>
    </aside>
  </section>
</Base>
